# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_DATA=

# Local auth + SQLite
AUTH_SECRET=change-me-local-dev-secret
SQLITE_DB_PATH=data/codebase_live_ai.db

# OpenAI Realtime (backend only)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Voice turn detection tuning
REALTIME_VAD_THRESHOLD=0.58
REALTIME_VAD_PREFIX_PADDING_MS=220
REALTIME_VAD_SILENCE_DURATION_MS=850
